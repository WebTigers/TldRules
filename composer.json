{
    "name": "webtigers/tld-rules",
    "description": "Zero-dependency catalog + query API of per-TLD domain-registration rules: required registrant extended attributes (OpenSRS tld_data), WHOIS-privacy availability, and registration-period bounds. Language-neutral JSON data included.",
    "type": "library",
    "keywords": ["domains", "tld", "registrar", "opensrs", "tld_data", "nexus", "whois-privacy", "icann", "registration"],
    "homepage": "https://github.com/WebTigers/TldRules",
    "license": "BSD-3-Clause",
    "authors": [
        { "name": "WebTigers", "homepage": "https://webtigers.com" }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": { "WebTigers\\TldRules\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "WebTigers\\TldRules\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
